generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkMode {
  ONLINE  @map("online")
  OFFLINE @map("offline")
  BUSY    @map("busy")

  @@map("work_mode")
}

enum WorkspaceMemberRole {
  OWNER  @map("owner")
  ADMIN  @map("admin")
  MEMBER @map("member")

  @@map("workspace_member_role")
}

enum ChannelMemberRole {
  ADMIN  @map("admin")
  MEMBER @map("member")

  @@map("channel_member_role")
}

enum ChannelType {
  TEXT  @map("text")
  VOICE @map("voice")
  DM    @map("dm")

  @@map("channel_type")
}

enum MessageType {
  TEXT   @map("text")
  CONFIG @map("config")
  GIF    @map("gif")

  @@map("message_type")
}

enum FriendStatus {
  PENDING  @map("pending")
  ACCEPTED @map("accepted")
  REJECTED @map("rejected")
  BLOCKED  @map("blocked")

  @@map("friend_status")
}

enum MemberStatus {
  ACTIVE          @map("active")
  LEFT            @map("left")
  BANNED          @map("banned")
  PENDING_REQUEST @map("pending_request")
  PENDING_INVITE  @map("pending_invite")
  CANCELED        @map("canceled")

  @@map("member_status")
}

enum Gender {
  MALE   @map("male")
  FEMALE @map("female")
  OTHER  @map("other")

  @@map("gender")
}

enum WorkspaceInvitePolicy {
  EVERYONE     @map("everyone")
  FRIENDS_ONLY @map("friends_only")

  @@map("workspace_invite_policy")
}

enum ChannelInviteStatus {
  ACTIVE  @map("active")
  REVOKED @map("revoked")

  @@map("workspace_invite_status")
}

model User {
  id          BigInt   @id @default(autoincrement()) // kiểu dữ liệu prisma - khóa chính - mặc định tự động tăng - kiểu trong db mysql
  email       String   @unique @db.VarChar(255)
  password    String   @db.VarChar(255)
  username    String?  @unique @db.VarChar(100)
  displayName String?  @map("display_name") @db.VarChar(100) // kiểu dữ liệu prisma - đổi tên column - kiểu trong db mysql
  avatar      String?  @db.VarChar(500)
  bio         String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  dateOfBirth String?  @db.VarChar(100)
  phone       String?  @db.VarChar(100)
  gender      Gender?  @default(MALE)
  fullName    String?  @db.VarChar(100)

  refreshTokens     RefreshToken[]
  ownedWorkspaces   Workspace[]        @relation("WorkspaceOwner")
  workspaceMembers  WorkspaceMember[]
  channelMembers    ChannelMember[]
  messages          Message[]          @relation("MessageSender")
  reactions         MessageReaction[]
  channelReadStates ChannelReadState[] @relation("ChannelReadUser")

  sentFriendRequests     Friend[]                @relation("FriendRequester")
  receivedFriendRequests Friend[]                @relation("FriendAddressee")
  pinnedMessages         PinnedMessage[]
  channelNicknames       ChannelMemberNickname[]
  setting                UserSetting?

  // Workspace member relations
  invitedWorkspaceMembers   WorkspaceMember[] @relation("WorkspaceMemberInviter")
  requestedWorkspaceMembers WorkspaceMember[] @relation("WorkspaceMemberRequester")

  // Channel member relations
  channelInviters ChannelMember[] @relation("ChannelMemberInviter")

  // Channel invite link
  channelInvitesCreated ChannelInvite[] @relation("ChannelInviteCreator")
  channelInvitesRevoked ChannelInvite[] @relation("ChannelInviteRevoker")

  @@map("users") // Đổi tên bảng
}

model Friend {
  id BigInt @id @default(autoincrement())

  requesterId BigInt @map("requester_id")
  addresseeId BigInt @map("addressee_id")

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade, map: "friends_requester_id_fk")
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade, map: "friends_addressee_id_fk")

  status FriendStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
  @@map("friends")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  token     String   @unique @db.VarChar(255)
  iat       Int      @map("iat")
  exp       Int      @map("exp")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "refresh_tokens_user_id_fkey") // Thiết lập quan hệ // ràng buộc khóa ngoại với khóa chính // onDelete: Cascade: khi xóa record cha thì record con cũng bị xóa

  @@index([userId]) // Tạo index
  @@map("refresh_tokens") // Đổi tên bảng 
}

model Workspace {
  id          BigInt   @id @default(autoincrement())
  name        String?  @db.VarChar(255)
  description String?  @db.Text
  avatar      String?  @db.VarChar(500)
  ownerId     BigInt?  @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner      User?             @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: SetNull, map: "workspaces_owner_id_fkey")
  members    WorkspaceMember[]
  categories CategoryChannel[]
  channels   Channel[]

  @@index([ownerId])
  @@map("workspaces")
}

model CategoryChannel {
  id          BigInt   @id @default(autoincrement())
  workspaceId BigInt   @map("workspace_id")
  name        String   @db.VarChar(100)
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "category_channels_workspace_id_fkey")
  channels  Channel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("category_channels")
}

model WorkspaceMember {
  workspaceId BigInt              @map("workspace_id")
  userId      BigInt              @map("user_id")
  role        WorkspaceMemberRole @default(MEMBER)
  status      MemberStatus        @default(ACTIVE) @map("status")

  // joinedAt: thời điểm user chính thức gia nhập workspace
  // (join qua invite thẳng vào channel nên gần như = createdAt của row)
  joinedAt DateTime @default(now()) @map("joined_at")
  invitedAt DateTime? @map("invited_at")

  // Người liên quan (nullable, set khi có)
  invitedById   BigInt? @map("invited_by_id")
  requestedById BigInt? @map("requested_by_id")

  // Relations
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "workspace_members_workspace_id_fkey")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "workspace_members_user_id_fkey")
  invitedBy   User?     @relation("WorkspaceMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull, map: "workspace_members_invited_by_id_fkey")
  requestedBy User?     @relation("WorkspaceMemberRequester", fields: [requestedById], references: [id], onDelete: SetNull, map: "workspace_members_requested_by_id_fkey")

  @@id([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

model ChannelInvite {
  id          BigInt                @id @default(autoincrement())
  code        String                @unique @db.VarChar(32)
  channelId   BigInt                @map("channel_id")
  status      ChannelInviteStatus @default(ACTIVE)
  expiresAt   DateTime?             @map("expires_at")
  createdById BigInt                @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  revokedAt   DateTime?             @map("revoked_at")
  revokedById BigInt?               @map("revoked_by_id")

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, map: "channel_invites_channel_id_fkey")
  createdBy User    @relation("ChannelInviteCreator", fields: [createdById], references: [id], onDelete: SetNull, map: "channel_invites_created_by_id_fkey")
  revokedBy User?   @relation("ChannelInviteRevoker", fields: [revokedById], references: [id], onDelete: SetNull, map: "channel_invites_revoked_by_id_fkey")

  @@index([channelId, status])
  @@index([expiresAt])
  @@map("channel_invites")
}

model Channel {
  id          BigInt       @id @default(autoincrement())
  workspaceId BigInt?      @map("workspace_id")
  categoryId  BigInt?      @map("category_id")
  name        String?      @db.VarChar(100)
  description String?      @db.Text
  type        ChannelType?
  isPrivate   Boolean      @default(false) @map("is_private")
  isDefault   Boolean      @default(false) @map("is_default")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  workspace      Workspace?              @relation(fields: [workspaceId], references: [id], onDelete: Cascade, map: "channels_workspace_id_fkey")
  category       CategoryChannel?        @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "channels_category_id_fkey")
  members        ChannelMember[]
  messages       Message[]
  readStates     ChannelReadState[]      @relation("ChannelReadChannel")
  config         ChannelConfig?
  pinnedMessages PinnedMessage[]
  nicknames      ChannelMemberNickname[]
  invites        ChannelInvite[]

  @@index([workspaceId])
  @@index([categoryId])
  @@index([isDefault])
  @@map("channels")
}

model ChannelMember {
  channelId   BigInt            @map("channel_id")
  userId      BigInt            @map("user_id")
  role        ChannelMemberRole @default(MEMBER)
  status      MemberStatus      @default(ACTIVE) @map("status")
  joinedAt    DateTime          @default(now())   @map("joined_at")
  invitedById BigInt?           @map("invited_by_id")

  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, map: "channel_members_channel_id_fkey")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "channel_members_user_id_fkey")
  invitedBy User?   @relation("ChannelMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull, map: "channel_members_invited_by_id_fkey")

  @@id([channelId, userId])
  @@index([userId])
  @@index([channelId, status])
  @@index([invitedById])
  @@map("channel_members")
}

model Message {
  id          BigInt      @id @default(autoincrement())
  channelId   BigInt      @map("channel_id")
  senderId    BigInt      @map("sender_id")
  content     String?     @db.Text
  messageType MessageType @map("message_type")
  replyToId   BigInt?     @map("reply_to")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")

  channel     Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade, map: "messages_channel_id_fkey")
  sender      User              @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade, map: "messages_sender_id_fkey")
  replyTo     Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull, map: "messages_reply_to_fkey")
  replies     Message[]         @relation("MessageReplies")
  attachments Attachment[]
  reactions   MessageReaction[]
  pinnedIn    PinnedMessage[]

  @@index([channelId])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

model ChannelReadState {
  userId            BigInt    @map("user_id")
  channelId         BigInt    @map("channel_id")
  lastReadMessageId BigInt?   @map("last_read_message_id")
  lastReadAt        DateTime? @map("last_read_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user    User    @relation("ChannelReadUser", fields: [userId], references: [id], onDelete: Cascade, map: "channel_read_states_user_id_fkey")
  channel Channel @relation("ChannelReadChannel", fields: [channelId], references: [id], onDelete: Cascade, map: "channel_read_states_channel_id_fkey")

  @@id([userId, channelId])
  @@index([channelId])
  @@map("channel_read_states")
}

model Attachment {
  id        BigInt   @id @default(autoincrement())
  messageId BigInt   @map("message_id")
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url") @db.VarChar(1000)
  mimeType  String   @map("mime_type") @db.VarChar(100)
  fileSize  BigInt   @map("file_size")
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "attachments_message_id_fkey")

  @@index([messageId])
  @@map("attachments")
}

model Emoji {
  id        BigInt  @id @default(autoincrement())
  shortcode String  @db.VarChar(100)
  unicode   String  @db.VarChar(20)
  imageUrl  String? @map("image_url") @db.VarChar(500)

  reactions MessageReaction[]

  @@map("emojis")
}

model MessageReaction {
  messageId BigInt   @map("message_id")
  userId    BigInt   @map("user_id")
  emojiId   BigInt   @map("emoji_id")
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "message_reactions_message_id_fkey")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "message_reactions_user_id_fkey")
  emoji   Emoji   @relation(fields: [emojiId], references: [id], onDelete: Cascade, map: "message_reactions_emoji_id_fkey")

  @@id([messageId, userId, emojiId])
  @@index([userId])
  @@index([emojiId])
  @@map("message_reactions")
}

model ChannelConfig {
  id            BigInt   @id @default(autoincrement())
  channelId     BigInt   @unique @map("channel_id")
  backgroundUrl String?  @map("background_url") @db.VarChar(500)
  accent        String?  @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, map: "channel_configs_channel_id_fkey")

  @@map("channel_configs")
}

model PinnedMessage {
  id        BigInt   @id @default(autoincrement())
  channelId BigInt   @map("channel_id")
  messageId BigInt   @map("message_id")
  pinnedBy  BigInt   @map("pinned_by")
  pinnedAt  DateTime @default(now()) @map("pinned_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, map: "pinned_messages_channel_id_fkey")
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade, map: "pinned_messages_message_id_fkey")
  user    User    @relation(fields: [pinnedBy], references: [id], onDelete: Cascade, map: "pinned_messages_pinned_by_fkey")

  @@unique([channelId, messageId])
  @@index([channelId])
  @@map("pinned_messages")
}

model ChannelMemberNickname {
  id        BigInt   @id @default(autoincrement())
  channelId BigInt   @map("channel_id")
  userId    BigInt   @map("user_id")
  nickname  String?  @db.VarChar(100)
  updatedAt DateTime @updatedAt @map("updated_at")

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, map: "channel_member_nicknames_channel_id_fkey")
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "channel_member_nicknames_user_id_fkey")

  @@unique([channelId, userId])
  @@map("channel_member_nicknames")
}

model UserSetting {
  id     BigInt @id @default(autoincrement())
  userId BigInt @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_settings_user_id_fkey")

  // Privacy settings
  showEmail       Boolean @default(true) @map("show_email")
  showPhone       Boolean @default(true) @map("show_phone")
  showDateOfBirth Boolean @default(true) @map("show_date_of_birth")
  showGender      Boolean @default(true) @map("show_gender")

  // Work mode (thay thế status ở User)
  workMode WorkMode @default(ONLINE) @map("work_mode")

  // Invite policy
  workspaceInvitePolicy WorkspaceInvitePolicy @default(EVERYONE) @map("workspace_invite_policy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_settings")
}
